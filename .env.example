# Copy to .env on the computer that runs Hermes. Git ignores .env.

# Twilio: the account, and the number that calls you
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15550001111

# Your phone, the one paired with the Fitbit (E.164 format)
OWNER_PHONE_NUMBER=+15552223333

# The public HTTPS address of the call server, with no path. For example, from: tailscale funnel --bg 8650
CALL_PUBLIC_URL=https://your-computer.your-tailnet.ts.net
CALL_PORT=8650

# The Hermes API server: the same value as API_SERVER_KEY in ~/.hermes/.env
HERMES_API_KEY=
HERMES_API_URL=http://127.0.0.1:8642
# Every call continues this Hermes conversation
HERMES_CONVERSATION=watch-call
